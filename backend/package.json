{
  "name": "inventory-api",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start-server": "bun src/index.ts",
    "seed": "bun scripts/seed.ts",
    "migrate-status": "node --env-file-if-exists=.env scripts/migrate.js status",
    "migrate-up": "node --env-file-if-exists=.env scripts/migrate.js up",
    "migrate-down": "node --env-file-if-exists=.env scripts/migrate.js down",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "cookie": "1.0.2",
    "elysia": "^1.4.0",
    "file-type": "^20.4.1",
    "jose": "^6.1.0",
    "migrate-mongo": "14.0.7",
    "mongodb": "^6.20.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/migrate-mongo": "^14",
    "bun": "1.4.3",
    "mongodb-memory-server": "^10.3.0",
    "typescript": "^5.9.3"
  },
  "dependenciesMeta": {
    "bun": {
      "built": true
    }
  }
}
