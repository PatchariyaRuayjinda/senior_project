PORT=3001
APP_ORIGIN=http://localhost:5173
# Atlas connection string; URL-encode special characters in the database password.
MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=inventory_dev
# Generate two DIFFERENT values: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Used only by yarn seed. Passwords must be 12-128 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STAFF_USERNAME=staff
STAFF_PASSWORD=
